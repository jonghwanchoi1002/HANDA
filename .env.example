# Copy this file to .env.local. Never commit real connection strings.
# Keep sample mode until db:migrate, db:seed, and db:check succeed.
CONTENT_SOURCE=sample
# Neon Connect > pooled PostgreSQL URL. Paste the full URL locally only.
DATABASE_URL=

# Authentication: generate a private random secret of at least 32 characters.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
# Authentication email: gmail or resend. Defaults to resend for existing deployments.
# Gmail uses a Google App Password, never the normal Google account password.
MAIL_PROVIDER=resend
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Resend: verified domain required for sending to other recipients.
RESEND_API_KEY=
MAIL_FROM=
# Google Cloud OAuth Web application credentials (optional until configured).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Private Vercel Blob store, server only. Never use NEXT_PUBLIC_ for this token.
# Optional until image uploads are enabled. Use separate stores for dev/prod.
BLOB_READ_WRITE_TOKEN=

# Vercel Production only: private store connected with prefix BLOB_PROD.
# VERCEL_ENV is set automatically by Vercel; local/Preview keep using BLOB_READ_WRITE_TOKEN.
BLOB_PROD_READ_WRITE_TOKEN=
